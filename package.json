{
  "name": "airlock",
  "private": true,
  "version": "0.4.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @airlock/ui electron:dev",
    "build": "pnpm --filter @airlock/core build && pnpm --filter @airlock/ui build",
    "package": "pnpm --filter @airlock/core build && pnpm --filter @airlock/ui build && electron-builder",
    "prepackage": "node scripts/verify-sandbox-bundle.mjs",
    "sandbox:build": "DOCKER_BUILDKIT=1 docker buildx build --load -t airlock/sandbox:latest ./packages/sandbox",
    "sandbox:smoke": "bash scripts/sandbox-smoke.sh",
    "core:smoke": "pnpm --filter @airlock/core build && node --import ./scripts/register-core.mjs scripts/core-smoke.mjs",
    "airlock:test": "pnpm --filter @airlock/core build && pnpm --filter @airlock/test-harness build && pnpm --filter @airlock/test-harness smoke",
    "pretest:smoke": "pnpm build && pnpm sandbox:build",
    "typecheck": "pnpm --filter @airlock/core typecheck && pnpm --filter @airlock/ui typecheck",
    "test": "pnpm --filter @airlock/core test",
    "lint": "eslint packages/core/src packages/ui/src --ext .ts,.tsx",
    "lint:fix": "eslint packages/*/src --ext .ts,.tsx --fix",
    "format": "prettier --write 'packages/core/src/**/*.ts' 'packages/ui/src/**/*.{ts,tsx}' --ignore-path .prettierignore",
    "format:check": "prettier --check 'packages/core/src/**/*.ts' 'packages/ui/src/**/*.{ts,tsx}' --ignore-path .prettierignore",
    "ci:lint": "node scripts/check-renderer-core-imports.mjs && node scripts/check-openclaw-leftovers.mjs && pnpm lint && pnpm format:check",
    "ci:docker": "docker build -t airlock/sandbox:test ./packages/sandbox",
    "verify-receipt": "pnpm --filter @airlock/core build && node scripts/verify-receipt.mjs"
  },
  "build": {
    "appId": "com.airlock.app",
    "productName": "Airlock",
    "executableName": "airlock",
    "directories": {
      "output": "dist",
      "app": "packages/ui"
    },
    "files": [
      "dist/**/*",
      "build/icons/icon.png",
      "package.json",
      "!src/**",
      "!node_modules/@airlock/core/src/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ssh2/**/*",
      "**/node_modules/cpu-features/**/*"
    ],
    "extraResources": [
      {
        "from": "packages/sandbox",
        "to": "sandbox",
        "filter": [
          "Dockerfile",
          "entrypoint.sh",
          "supervisord.conf",
          "launch-target.sh",
          "start-kasmvnc.sh",
          "cleanup.sh"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": ["*.md"]
      },
      {
        "from": "packages/ui/build/icons",
        "to": "icons",
        "filter": ["icon.png"]
      }
    ],
    "icon": "packages/ui/build/icons/icon.png",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "packages/ui/build/icons/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "packages/ui/build/icons/icon.ico",
      "legalTrademarks": "Airlock",
      "executableName": "airlock"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "packages/ui/build/icons/icon.png"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.5.0"
  }
}